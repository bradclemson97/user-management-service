# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
# SPRING_DATASOURCE_PASSWORD overrides the hardcoded 'password' default in application.yml
SPRING_DATASOURCE_PASSWORD=password

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/system

# ── Downstream service URLs ───────────────────────────────────────────────────
ACM_URL=http://localhost:8130
KEYCLOAK_MANAGER_URL=http://localhost:8210

# ── Bootstrap superuser (Flyway placeholders) ─────────────────────────────────
# SYSTEM_ADMIN_USERNAME=superuser@system.local
# SYSTEM_ADMIN_FIRSTNAME=Super
# SYSTEM_ADMIN_LASTNAME=User
# SYSTEM_ADMIN_EMAIL=superuser@system.local
# SYSTEM_ADMIN_SYSTEMUSER_ID=a0000000-0000-0000-0000-000000000001

# ── Optional overrides ────────────────────────────────────────────────────────
# SERVER_PORT=8080
# CACHE_EXPIRE_AFTER=60
# CACHE_EXPIRY_UNITS=MINUTES
# CACHE_MAX_SIZE=1000
